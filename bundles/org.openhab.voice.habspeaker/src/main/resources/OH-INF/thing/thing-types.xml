<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="habspeaker"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">
	<!-- Sample Thing Type -->
	<thing-type id="speaker">
		<label>HAB Speaker Thing</label>
		<description>Represents a connected speaker</description>
		<channels>
			<channel id="sink-volume" typeId="system.volume"/>
		</channels>
		<config-description>
			<parameter-group name="audio">
				<label>Audio</label>
				<description>Sink and source options.</description>
			</parameter-group>
			<parameter-group name="voice">
				<label>Voice</label>
				<description>Voice configuration options for this speaker (leave unset to use the default voice options).</description>
			</parameter-group>
			<parameter name="sinkVolume" type="decimal" min="0" max="100" step="1" groupName="audio">
				<label>Sink Volume</label>
				<description>Default sink volume</description>
				<default>80</default>
			</parameter>
			<parameter name="sinkStereo" type="boolean" groupName="audio">
				<label>Sink Stereo</label>
				<description>Use dual channel audio</description>
				<default>false</default>
			</parameter>
			<parameter name="listeningItem" type="text" groupName="voice">
				<context>item</context>
				<filter>
					<criteria name="type">Switch</criteria>
				</filter>
				<label>Listening Switch</label>
				<description>If provided, the item will be switched on during the period when the dialog processor has spotted the
					keyword and is listening for commands.</description>
			</parameter>
		</config-description>
	</thing-type>

	<!-- Client Channels -->
</thing:thing-descriptions>

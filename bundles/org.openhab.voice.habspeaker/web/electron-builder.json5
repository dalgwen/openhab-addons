/**
 * @see https://www.electron.build/configuration/configuration
 */
{
  "appId": "dev.givimad.habspeaker",
  "productName": "HABSpeaker",
  "asar": true,
  "directories": {
    "buildResources": "electron-resources",
    "output": "electron-release/${version}"
  },
  "asarUnpack": [
    "librespot/*"
  ],
  "files": [
    {
      "from": "dist-electron",
      "to": ""
    },
    {
      "from": "librespot",
      "to": "librespot"
    },
    {
      "from": "dist",
      "to": "habspeaker"
    },
    "package.json"
  ],
  "mac": {
    "icon": "electron-resources/icons/mac/icon.icns",
    "artifactName": "${productName}_${version}_macOS_${arch}.${ext}",
    "target": [
      "dmg"
    ],
    "extendInfo": {
        "NSMicrophoneUsageDescription": "HABSpeaker requires access to your microphone",
        "NSCameraUsageDescription": "Please give HABSpeaker access to your camera",
        "com.apple.security.device.audio-input": true,
        "com.apple.security.device.camera": true
      },
  },
  linux: {
    category: "Utility",
    artifactName: "${productName}_${version}_linux_${arch}.${ext}",
    target: ["AppImage"],
    "icon": "electron-resources/icons/png",
  },
  "win": {
    "icon": "electron-resources/icons/win/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}_${version}_windows_${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  }
}

/**
 * @see https://www.electron.build/configuration/configuration
 */
{
  "appId": "dev.givimad.${name}",
  "productName": "HABSpeaker",
  "asar": true,
  "directories": {
    "output": "release/${version}"
  },
  "asarUnpack": [
    "librespot/*"
  ],
  "files": [
    {
      "from": "dist-electron",
      "to": ""
    },
    {
      "from": "librespot",
      "to": "librespot"
    },
    {
      "from": "dist",
      "to": "habspeaker"
    },
    "package.json"
  ],
  "mac": {
    "artifactName": "${productName}_${version}.${ext}",
    "target": [
      "dmg"
    ]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}_${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  }
}

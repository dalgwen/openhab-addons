{
  "name": "hab-speaker",
  "author": {
    "name": "GiviMAD"
  },
  "description": "A smart speaker UI concept for openHAB",
  "version": "0.0.20",
  "scripts": {
    "dev": "vite --mode pwa",
    "dev:electron": "vite --mode electron",
    "dev:capacitor": "NODE_ENV=development npm run build:capacitor && cap run --no-sync",
    "build": "vite build --mode pwa",
    "build:dev": "NODE_ENV=development vite build --mode pwa",
    "build:electron": "vite build --mode electron && electron-builder",
    "sync:capacitor": "npm run fix-capacitor-plugins && cap sync && npm run rm-fix-capacitor-plugins",
    "build:capacitor": "vite build --mode capacitor && cap copy",
    "install-capacitor-plugins": "npm i capacitor-voice-recorder @capacitor/preferences @capacitor/dialog @capacitor-community/screen-brightness @capacitor-community/keep-awake",
    "rm-capacitor-plugins": "npm rm capacitor-voice-recorder @capacitor/preferences @capacitor/dialog @capacitor-community/screen-brightness @capacitor-community/keep-awake",
    "fix-capacitor-plugins": "npm run install-capacitor-plugins -- --save-dev",
    "rm-fix-capacitor-plugins": "npm run rm-capacitor-plugins -- --save-dev && npm run install-capacitor-plugins -- --save-optional && npm i",
    "preview": "vite preview --port 4173",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.2.1",
    "@fortawesome/free-solid-svg-icons": "^6.2.1",
    "@fortawesome/vue-fontawesome": "^3.0.2",
    "axios": "^1.2.1",
    "pinia": "^2.0.27",
    "pkce-challenge": "^3.0.0",
    "reentrant-lock": "^2.0.1",
    "rustpotter-worklet": "2.0.0",
    "vue": "^3.2.41",
    "vue-router": "^4.1.6"
  },
  "devDependencies": {
    "@types/audioworklet": "0.0.36",
    "@types/dom-screen-wake-lock": "^1.0.0",
    "@types/spotify-web-playback-sdk": "^0.1.15",
    "@types/youtube": "^0.0.47",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/eslint-config-prettier": "^7.0.0",
    "eslint": "^8.22.0",
    "eslint-plugin-vue": "^9.3.0",
    "prettier": "^2.7.1",
    "typescript": "^4.6.4",
    "vite": "^4.0.0",
    "vite-plugin-conditional-compiler": "^0.0.6",
    "vite-plugin-pwa": "^0.14.0",
    "vue-tsc": "^1.0.9"
  },
  "optionalDependencies": {
    "@capacitor-community/keep-awake": "^3.0.0",
    "@capacitor-community/screen-brightness": "^4.0.0",
    "@capacitor/android": "^4.6.1",
    "@capacitor/app": "^4.1.1",
    "@capacitor/cli": "^4.6.1",
    "@capacitor/core": "^4.6.1",
    "@capacitor/dialog": "^4.1.0",
    "@capacitor/ios": "^4.6.1",
    "@capacitor/preferences": "^4.0.2",
    "capacitor-voice-recorder": "^4.0.2",
    "electron": "^22.0.0",
    "electron-builder": "^23.6.0",
    "vite-plugin-electron": "^0.11.1"
  }
}

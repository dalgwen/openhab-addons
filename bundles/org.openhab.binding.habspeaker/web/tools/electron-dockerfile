# Build habspeaker for targeted platform
FROM node:18
WORKDIR /code
COPY package*.json /code/
COPY electron-builder.json5 /code/
RUN npm ci
COPY electron-resources /code/electron-resources
COPY electron /code/electron
COPY public /code/public
COPY index.html /code/
COPY vite.config.ts /code/
COPY tsconfig*.json /code/
COPY src /code/src
RUN npm run build:electron
